///---\\\
:GRAPH POPULATIONS
:TITLE Populations
:SCALE
:VAR Adopters A
:LINE-WIDTH 2
:VAR Total Population N
:LINE-WIDTH 2
:VAR Population Willing to Adopt M
:LINE-WIDTH 2

:GRAPH ADOPTION_RATE
:TITLE Adoption Rate
:SCALE
:VAR Adoption Rate AR
:VAR Adoption from Advertising
:VAR Adoption from Word of Mouth

:GRAPH PRICE_AND_LEARNING
:TITLE Price and Learning
:SCALE
:VAR Average Price
:SCALE
:VAR Fraction Willing to Adopt
:SCALE
:VAR Cumulative Experience

:GRAPH REVENUE
:TITLE Revenue
:X-AXIS time
:SCALE
:VAR Revenue

:GRAPH Sales
:TITLE Sales
:SCALE
:VAR Purchase Rate
:LINE-WIDTH 2
:VAR Purchase Rate
:DATASET VCR data

:GRAPH Adoption_Fraction
:TITLE Adoption Fraction
:SCALE
:VAR Adoption Fraction
:Y-MIN 0
:Y-MAX 1
:LINE-WIDTH 2
:VAR Adoption Fraction
:DATASET VCR data
:LINE-WIDTH 2

:GRAPH Price
:TITLE Price
:SCALE
:VAR Average Price
:LINE-WIDTH 2
:VAR Average Price
:DATASET VCR data
:LINE-WIDTH 2

:GRAPH Net_Income
:TITLE Net Income
:SCALE
:VAR Net Income

:GRAPH Cumulative_Profit
:TITLE Cumulative Profit
:SCALE
:VAR Cumulative Profit

:GRAPH Unit_Cost
:TITLE Unit Cost
:X-AXIS time
:SCALE
:VAR Unit Cost
:LINE-WIDTH 2

:GRAPH Fraction_Willing_to_Adop
:TITLE Fraction Willing to Adopt
:X-AXIS time
:SCALE
:VAR Fraction willing to adopt
:Y-MIN 0
:Y-MAX 1
:LINE-WIDTH 2

:TABLE Cumulative_Net_Income
:TITLE Cumulative_Net_Income
:PRETTYNUM
:PRINT-EVERY 1
:X-MIN 1975
:X-MAX 2000
:TIME-DOWN
:FIRST-CELLWIDTH 12
:CELLWIDTH 18
:FONT Arial|10|B|0-0-0
:VAR Net Income
:VAR Cumulative Profit

:GRAPH Installed_Base
:TITLE Installed Base
:SCALE
:VAR Installed Base

:GRAPH Sales_and_Retirements
:TITLE Sales and Retirements
:SCALE
:VAR Purchase Rate
:VAR Product Retirement

:GRAPH Cumulative_Experience
:TITLE Cumulative Experience
:SCALE
:VAR Cumulative Experience

:GRAPH Purchase_Rate
:TITLE Purchase Rate
:SCALE
:VAR Purchase Rate
:Y-MIN 0
:LINE-WIDTH 3

:GRAPH Adopters_and_Population_
:TITLE Adopters and Population Willing to Adopt
:SCALE
:VAR Population Willing to Adopt M
:VAR Adopters A
:L<%^E!@
