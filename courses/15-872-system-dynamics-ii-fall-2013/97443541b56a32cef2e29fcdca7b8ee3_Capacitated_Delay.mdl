{UTF-8}
Capacity=
	250
	~	Letters/Day
	~		|

Capacity Utilization=
	MIN(1, Desired Shipment Rate 0/Capacity)
	~	Dmnl
	~		|

Desired Shipment Rate=
	Letters to Ship Uncapacitated/Processing Time
	~	Letters/Day
	~		|

Desired Shipment Rate 0=
	Letters to Ship Capacitated/Processing Time
	~	Letters/Day
	~		|

Letters Shipment Rate Uncapacitated=
	Desired Shipment Rate
	~	Letters/Day
	~		|

Letters Shipment Rate Capacitated=
	Capacity*Capacity Utilization
	~	Letters/Day
	~		|

Exogenous Letters Arrival Rate=
	Initial Arrival Rate*Input
	~	Letters/Day
	~	The exogenous task arrival rate can be configured to include a range of \
		test inputs.  It is set to the product of the initial arrival rate and the \
		test input.  The test input allows users to specify a range of input \
		patterns, including a step, pulse, ramp, cycle, and pink noise, or \
		combinations of these.
	|

Pulse Quantity=
	0
	~	Dimensionless*Day
	~	The quantity to be injected to customer orders, as a fraction of the base value of \
		Input. 
		        For example, to pulse in a quantity equal to 50% of the current value of \
		input, set to
		         .50.
	|

Input=
	1+STEP(Step Height in Letters Arrivals,Step Time)+
	(Pulse Quantity/Pulse Duration)*PULSE(Pulse Time,Pulse Duration)+
	RAMP(Ramp Slope,Ramp Start Time,Ramp End Time)+
	Sine Amplitude*SIN(2*3.14159*Time/Sine Period)
	~	Dimensionless
	~	Input is a dimensionless variable which provides a variety of test input patterns, \
		including a step,
		         pulse, sine wave, and random noise.
	|

Ramp End Time=1e+009
	~	Day
	~	End time for the ramp input.
	|

Letters Arrival Rate 0=
	Exogenous Letters Arrival Rate
	~	Letters/Day
	~	Task Arrivals are set to an exogenous rate.
	|

Ramp Start Time=
	0
	~	Day
	~	Start time for the ramp input.
	|

Sine Period=
	4
	~	Day
	~	Period of sine wave in customer demand.  Set initially to 4 years to \
		simulate the business cycle
	|

Letters to Ship Capacitated= INTEG (
	Letters Arrival Rate 0-Letters Shipment Rate Capacitated,
		Letters Arrival Rate 0*Processing Time)
	~	Letters
	~	The initial backlog is set to the equilibrium value determined by the \
		arrival rate and target delivery delay.
	|

Step Time=
	10
	~	Day
	~	Time for the step input.
	|

Pulse Duration=
	1
	~	Day
	~	Duration of pulse input.  Set to Time Step for an impulse.
	|

Sine Amplitude=0
	~	Dimensionless
	~	Amplitude of sine wave in customer orders (fraction of mean).
	|

Pulse Time=
	0
	~	Day
	~	Time at which the pulse in Input occurs.
	|

Step Height in Letters Arrivals=
	0
	~	Dimensionless [0,0.5,0.01]
	~	Height of step input to customer orders, as fraction of initial value.
	|

Ramp Slope=0
	~	1/Day
	~	Slope of the ramp input, as a fraction of the base value (per year).
	|

Initial Arrival Rate= INITIAL(
	100)
	~	Letters/Day
	~	The initial rate at which letters arrive.
	|

Letters Arrival Rate=
	Exogenous Letters Arrival Rate
	~	Letters/Day
	~	Task Arrivals are set to an exogenous rate.
	|

Letters to Ship Uncapacitated= INTEG (
	Letters Arrival Rate-Letters Shipment Rate Uncapacitated,
		Letters Arrival Rate*Processing Time)
	~	Letters
	~	The initial backlog is set to the equilibrium value determined by the \
		arrival rate and target delivery delay.
	|

Processing Time=
	1
	~	Days
	~	The fastest possible completion time for customer requests.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Day [0,?]
	~	The time step for the simulation.
	|

