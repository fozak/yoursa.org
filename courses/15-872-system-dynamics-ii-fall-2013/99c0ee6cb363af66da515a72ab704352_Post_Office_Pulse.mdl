{UTF-8}
Mailing=
	Pulse Quantity*PULSE( 0,TIME STEP)
	~	letters/Day
	~	STEP(Step Quantity, Step Time)
	|

Pulse Quantity=
	1000
	~	letters/Day
	~	The quantity added to the input at the pulse time.
	|

Step Height=
	0
	~	letters/Day
	~	The height of the step increase in the input.
	|

Delivery=
	DELAY1( Mailing, Average Delivery Time )
	~	letters/Day
	~	DELAY3( Mailing, Average Delivery Time )
		DELAY FIXED(Mailing, Average Delivery Time, 0)
	|

Cumulative Delay Output= INTEG (
	Delivery,
		0)
	~	letters
	~		|

Letters in Transit= INTEG (
	Mailing-Delivery,
		Average Delivery Time*Mailing)
	~	letters
	~		|

Average Delivery Time=
	3
	~	Day
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = -5
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.03125
	~	Day [0,?]
	~	The time step for the simulation.
	|

